DJANGO_SECRET_KEY=changeme-in-production
DJANGO_DEBUG=True

# Comma-separated list of hostnames (no spaces) e.g. localhost,127.0.0.1,codeventure.onrender.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of fully-qualified origins (with scheme), e.g. https://codeventure-ez4m.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Production only: domain for Sites framework and OAuth (e.g. codeventure-ez4m.onrender.com). Build runs setup_site using this.
DJANGO_SITE_DOMAIN=

# Local development database (defaults to SQLite if unset)
# For Postgres on Render, Render will provide DATABASE_URL automatically, e.g.:
# postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# Google OAuth — see docs/OAUTH_AND_GOOGLE.md. Redirect URI in Console must be .../accounts/google/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
