# EditorConfig — consistent whitespace across editors
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,css,json,yml,yaml}]
indent_size = 2

# Django HTML templates — NEVER auto-format; it breaks {% %} tags
[*.html]
indent_size = 4
trim_trailing_whitespace = false
